{
  "name": "ctha-frontend",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Pannello React di CTHA, impacchettato come Web Component per Home Assistant",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke.mjs",
    "check": "npm run build && npm run smoke"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
