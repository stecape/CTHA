# Copia questo file in `.env` (stessa cartella) e compila con i valori reali
# del gateway BTicino/MyHOME. NON committare mai `.env` (è in .gitignore).

# Indirizzo IP del gateway OpenWebNet
HOST=

# Porta TCP del gateway OpenWebNet (default MyHOME: 20000)
PORT=20000

# Password numerica OpenWebNet (la stessa già configurata in MyHOME)
PASSWORD=

# Numero seriale del gateway, opzionale — necessario solo per alcuni modelli;
# lascia vuoto se non lo conosci
SERIAL_NUMBER=
